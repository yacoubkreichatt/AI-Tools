# ==============================================================================
# AI TOOLS HUB - ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# IMPORTANT:
# - NEVER commit real keys or secrets to version control.
# - Distinguish between PRIVATE (server-only) and PUBLIC (client-safe) variables.
#
# ==============================================================================
# 1. PRIVATE SERVER-SIDE VARIABLES (Never exposed to the browser)
# ==============================================================================
# GEMINI_API_KEY:
# Required ONLY if deploying with Node.js backend (server.ts) to enable Gemini API.
# If omitted or unavailable, AI Tools Hub automatically uses the built-in local engine.
GEMINI_API_KEY=your_gemini_api_key_here

# PORT:
# Server listen port for Node.js container or VPS environment. Defaults to 3000.
PORT=3000

# ==============================================================================
# 2. PUBLIC CLIENT-SIDE VARIABLES (Prefixed with VITE_, safe for browser bundle)
# ==============================================================================
# VITE_SITE_URL:
# Optional: Set this to your production domain on Hostinger (e.g. https://yourdomain.com).
# Used for dynamic canonical URLs, Open Graph tags, and structured JSON-LD data.
# If omitted, defaults automatically to the active window.location.origin in the browser.
VITE_SITE_URL=https://yourdomain.com

